
#include <iostream>
#include <unordered_map>
using namespace std;

int main() {
    int n, target;

    cout << "Enter array size: ";
    cin >> n;

    int a[n];

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    cout << "Enter target: ";
    cin >> target;

    unordered_map<int, int> mp;

    for (int i = 0; i < n; i++) {
        int need = target - a[i];

        if (mp.find(need) != mp.end()) {
            cout << "Indices: " << mp[need]
                 << " and " << i;
            return 0;
        }

        mp[a[i]] = i;
    }

    cout << "No pair found";

    return 0;
}
