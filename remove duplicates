
#include <iostream>
#include <unordered_set>
using namespace std;

int main() {
    int n, x;
    unordered_set<int> s;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";

    for (int i = 0; i < n; i++) {
        cin >> x;

        if (s.insert(x).second) {
            cout << x << " ";
        }
    }

    return 0;
}
