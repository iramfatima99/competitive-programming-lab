
#include <iostream>
using namespace std;

int main() {
    int n, num, result = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> num;
        result = result ^ num;
    }

    cout << "Single number is: " << result;

    return 0;
}
